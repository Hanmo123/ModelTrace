{
  "name": "modeltrace-web",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "package:static": "node scripts/package-static.mjs",
    "preview": "nuxt preview --port 4200",
    "test:auto": "npm run test:providers && node tests/api-runner-test.mjs && node tests/auto-test.mjs && node tests/multi-model-test.mjs",
    "test:providers": "node --test tests/providers-test.mjs",
    "test:core": "node --test tests/core-test.mjs",
    "test:multi": "node tests/multi-model-test.mjs",
    "test:analytics": "node tests/analytics-test.mjs",
    "test:terminal": "node tests/terminal-proxy-test.mjs",
    "test:proxy": "node tests/proxy-consent-test.mjs",
    "test:static": "node tests/static-package-test.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.48.0",
    "@vueuse/core": "^15.0.0",
    "ai": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.525.0",
    "nuxt": "^4.5.2",
    "nuxt-gtag": "^5.0.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^2.6.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-sonner": "^1.3.2"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "puppeteer-core": "^24.43.1",
    "shadcn-nuxt": "^2.1.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true
  }
}
