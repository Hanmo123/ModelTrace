name = "modeltrace-relay"
main = "src/index.mjs"
compatibility_date = "2025-07-01"
workers_dev = true

[vars]
# Must match the deployed production origin exactly (no trailing slash or path).
# HTTP(S) localhost origins on any valid port are additionally allowed by the Worker.
SITE_ORIGIN = "https://modeltrace.pages.dev"
# Upstream hosts are not configured here: the Worker accepts arbitrary public HTTPS
# OpenAI-compatible endpoints ending in /v1, while rejecting IP literals/local names.

# Mandatory per-IP rate limiting. Worker refuses requests when the binding is absent.
[[unsafe.bindings]]
name = "RATE_LIMITER"
type = "ratelimit"
# Use a different namespace for independent deployments in the same account.
namespace_id = "1001"
simple = { limit = 10, period = 60 }
